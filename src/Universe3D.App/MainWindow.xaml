<Window x:Class="Universe3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        xmlns:vm="clr-namespace:Universe3D.App.ViewModels"
        xmlns:res="clr-namespace:Universe3D.App.Resources"
        Title="Universe3D" Width="1500" Height="920" MinWidth="1100" MinHeight="680"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <vm:EnumMatchConverter x:Key="EnumMatch"/>
        <vm:EmptyToCollapsedConverter x:Key="EmptyToCollapsed"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>

    <DockPanel>
        <!-- ===================== Status bar ===================== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,1,0,0" Padding="10,3">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding FrameRateStatus}" Style="{StaticResource Muted}" Margin="16,0,0,0"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding CameraStatus}" Style="{StaticResource Muted}" Margin="16,0,0,0"
                           ToolTip="{res:Glossary LightYear Megaparsec}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataSetStatus}" Style="{StaticResource Muted}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ObjectsStatus}" Style="{StaticResource Muted}" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding ExcludedStatus}" Style="{StaticResource Muted}" Margin="16,0,0,0"
                               ToolTip="Objects whose velocity gives no valid distance (for example a blueshift with no measured distance) cannot be placed in 3D."/>
                    <TextBlock Text="{Binding Warning}" Foreground="{StaticResource WarningBrush}" FontSize="11" Margin="16,0,0,0"
                               Visibility="{Binding Warning, Converter={StaticResource EmptyToCollapsed}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Left: data sets, search, filters, display ===================== -->
        <Border DockPanel.Dock="Left" Width="310" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,4,10,10">
                <StackPanel>
                    <TextBlock Text="Data set" Style="{StaticResource SectionTitle}"/>
                    <ListBox x:Name="DataSetList" ItemsSource="{Binding DataSets}" SelectedItem="{Binding SelectedDataSet}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel ToolTip="{Binding Description}">
                                    <TextBlock>
                                        <Run Text="{Binding Number, Mode=OneWay}" Foreground="{StaticResource MutedBrush}"/>
                                        <Run Text="  "/><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="14,1,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="Find by name" Style="{StaticResource SectionTitle}"/>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Type a name: M31, NGC 4486, Coma, Abell 1656, 3C 273 (Ctrl+F). Enter goes to the best match.">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ChooseFirstResultCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}"
                             MaxHeight="160" Margin="0,4,0,0"
                             Visibility="{Binding SearchResults, Converter={StaticResource EmptyToCollapsed}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Detail, StringFormat='  {0}'}" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Expander Header="Filters" IsExpanded="True" DataContext="{Binding Filters}">
                        <StackPanel>
                            <TextBlock Text="Maximum distance" Style="{StaticResource FieldLabel}"
                                       ToolTip="{res:Glossary ComovingDistance LightYear Megaparsec}"/>
                            <TextBlock Text="{Binding MaxDistanceText}" Style="{StaticResource Muted}"
                                       ToolTip="{res:Glossary LightYear Megaparsec}"/>
                            <Slider Minimum="{Binding DistanceLogMin}" Maximum="{Binding DistanceLogMax}"
                                    Value="{Binding DistanceLog, Delay=30}" SmallChange="0.02" LargeChange="0.25"
                                    ToolTip="{res:Glossary ComovingDistance}"/>

                            <TextBlock Text="Types" Style="{StaticResource FieldLabel}" ToolTip="{res:Glossary HubbleType}"/>
                            <ItemsControl ItemsSource="{Binding Types}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" ToolTip="{Binding ToolTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="9" Height="9" Fill="{Binding Swatch}" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Label}"/>
                                                <TextBlock Text="{Binding CountText, StringFormat='  {0}'}"
                                                           Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Display" IsExpanded="True" DataContext="{Binding Filters}">
                        <StackPanel>
                            <TextBlock Text="Color by" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <RadioButton Content="Type" GroupName="Color" ToolTip="{res:Glossary HubbleType}"
                                             IsChecked="{Binding ColorMode, Converter={StaticResource EnumMatch}, ConverterParameter=Type}"/>
                                <RadioButton Content="Velocity (redshift / blueshift)" GroupName="Color"
                                             ToolTip="{res:Glossary Redshift Blueshift}"
                                             IsChecked="{Binding ColorMode, Converter={StaticResource EnumMatch}, ConverterParameter=Velocity}"/>
                            </WrapPanel>

                            <TextBlock Text="Coordinate frame" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <RadioButton Content="Supergalactic" GroupName="Frame" ToolTip="{res:Glossary Supergalactic}"
                                             IsChecked="{Binding Frame, Converter={StaticResource EnumMatch}, ConverterParameter=Supergalactic}"/>
                                <RadioButton Content="Galactic" GroupName="Frame" ToolTip="{res:Glossary Galactic}"
                                             IsChecked="{Binding Frame, Converter={StaticResource EnumMatch}, ConverterParameter=Galactic}"/>
                                <RadioButton Content="Equatorial" GroupName="Frame" ToolTip="{res:Glossary Equatorial}"
                                             IsChecked="{Binding Frame, Converter={StaticResource EnumMatch}, ConverterParameter=Equatorial}"/>
                            </WrapPanel>

                            <CheckBox Content="Galaxy shapes and cluster spheres" IsChecked="{Binding ShowShapes}" Margin="0,8,0,3"
                                      ToolTip="{res:Glossary HubbleType R500}"/>
                            <CheckBox Content="Names" IsChecked="{Binding ShowNames}"/>
                            <CheckBox Content="Scale rings" IsChecked="{Binding ShowRings}" ToolTip="{res:Glossary ScaleRings}"/>
                            <CheckBox Content="Milky Way" IsChecked="{Binding ShowMilkyWay}" ToolTip="{res:Glossary MilkyWay}"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Velocity arrows" IsExpanded="True" DataContext="{Binding Filters}">
                        <StackPanel>
                            <CheckBox Content="Show velocity arrows" IsChecked="{Binding ShowArrows}"
                                      ToolTip="{res:Glossary LineOfSightOnly Redshift Blueshift}"/>
                            <TextBlock Text="Arrow mode" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel>
                                <RadioButton Content="Observed" GroupName="ArrowMode" ToolTip="{res:Glossary Observed}"
                                             IsChecked="{Binding ArrowMode, Converter={StaticResource EnumMatch}, ConverterParameter=Observed}"/>
                                <RadioButton x:Name="PeculiarRadio" Content="Peculiar velocity" GroupName="ArrowMode"
                                             IsEnabled="{Binding PeculiarAvailable}" ToolTip="{Binding PeculiarToolTip}"
                                             ToolTipService.ShowOnDisabled="True"
                                             IsChecked="{Binding ArrowMode, Converter={StaticResource EnumMatch}, ConverterParameter=PeculiarVelocity}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Arrow scale"/><Run Text="{Binding ArrowScaleText, Mode=OneWay, StringFormat='  k = {0}'}"
                                                              Foreground="{StaticResource MutedBrush}"/>
                            </TextBlock>
                            <Slider Minimum="6" Maximum="40" Value="{Binding ArrowScale}" SmallChange="1" LargeChange="4"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    ToolTip="Arrow length in pixels: k × log10(1 + speed / 100 km/s), between 3 and 60 pixels."/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Quasar limit" IsExpanded="True" DataContext="{Binding Filters}"
                              Visibility="{Binding IsQuasarLimitVisible, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Show only the brightest quasars, by R magnitude (else B). Fewer is faster on slower graphics cards.">
                        <ListBox ItemsSource="{Binding QuasarLimitOptions}" SelectedValuePath="Count"
                                 SelectedValue="{Binding QuasarLimit}" DisplayMemberPath="Label"/>
                    </Expander>

                    <Expander Header="Catalogs" IsExpanded="False">
                        <StackPanel>
                            <TextBlock Text="{Binding CatalogStatus}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CatalogSources}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                            <Button Content="Download latest" IsEnabled="False"
                                    ToolTip="Rebuilds this data set from VizieR. Not available in this version yet."/>
                            <Button Content="Use built-in snapshot" Command="{Binding UseBuiltInCommand}"
                                    ToolTip="Forget the downloaded copy and go back to the data set shipped with the program."/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== Right: selected object ===================== -->
        <Border DockPanel.Dock="Right" Width="340" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,4,12,12" DataContext="{Binding Info}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,10,0,0"
                               Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding KindText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,8"/>
                    <WrapPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Fly to it" Command="{Binding DataContext.FlyToSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        <Button Content="Center on it (F)" Command="{Binding DataContext.CenterOnSelectedCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" ToolTip="{Binding ToolTip}" Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="12"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Controls" Style="{StaticResource SectionTitle}" Margin="0,18,0,4"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" xml:space="preserve">Left-drag: rotate      Right-drag: pan
Mouse wheel: zoom        Click: select
Double-click: fly to an object
Home: whole data set   F: center on selection
Ctrl+F: find by name
Hover a label for an explanation.</TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== 3D view ===================== -->
        <Grid>
            <gl:GLWpfControl x:Name="GlControl" Focusable="True"/>
            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True"/>
            <TextBlock Text="Loading…" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" IsHitTestVisible="False"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
        </Grid>
    </DockPanel>
</Window>
