<Window x:Class="Universe3D.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="Universe3D" Width="1280" Height="800" Background="#05050A"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#181820" Padding="8,6">
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="DataSetCombo" Width="220"
                          DisplayMemberPath="Label" SelectionChanged="DataSetCombo_SelectionChanged" />
                <TextBlock Text="Quasar limit" Foreground="#C0C0D0" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox x:Name="LimitCombo" Width="110" DisplayMemberPath="Label"
                          SelectionChanged="LimitCombo_SelectionChanged" />
                <CheckBox x:Name="SpinCheck" Content="Spin (perf test)" Foreground="#C0C0D0"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="SpinCheck_Changed" Unchecked="SpinCheck_Changed" />
                <CheckBox x:Name="ShapesCheck" Content="Shapes" IsChecked="True" Foreground="#C0C0D0"
                          VerticalAlignment="Center" Margin="16,0,0,0" Checked="Layer_Changed" Unchecked="Layer_Changed" />
                <CheckBox x:Name="SpheresCheck" Content="Cluster spheres" IsChecked="True" Foreground="#C0C0D0"
                          VerticalAlignment="Center" Margin="10,0,0,0" Checked="Layer_Changed" Unchecked="Layer_Changed" />
                <CheckBox x:Name="MilkyWayCheck" Content="Milky Way" IsChecked="True" Foreground="#C0C0D0"
                          VerticalAlignment="Center" Margin="10,0,0,0" Checked="Layer_Changed" Unchecked="Layer_Changed" />
                <CheckBox x:Name="RingsCheck" Content="Scale rings" IsChecked="True" Foreground="#C0C0D0"
                          VerticalAlignment="Center" Margin="10,0,0,0" Checked="Layer_Changed" Unchecked="Layer_Changed" />
                <TextBlock x:Name="FpsText" Foreground="#80E0A0" VerticalAlignment="Center" Margin="16,0,0,0"
                           FontFamily="Consolas" />
            </StackPanel>
        </Border>
        <Grid>
            <gl:GLWpfControl x:Name="GlControl"
                             MouseDown="Gl_MouseDown" MouseMove="Gl_MouseMove" MouseUp="Gl_MouseUp"
                             MouseWheel="Gl_MouseWheel" />
            <!-- Ring labels (the full label overlay arrives with the UI task). -->
            <Canvas x:Name="Overlay" IsHitTestVisible="False" ClipToBounds="True" />
        </Grid>
    </DockPanel>
</Window>
