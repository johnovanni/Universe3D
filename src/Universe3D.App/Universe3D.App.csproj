    <ApplicationIcon>Assets\Universe3D.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Universe3D.Rendering\Universe3D.Rendering.csproj" />
    <ProjectReference Include="..\Universe3D.Core\Universe3D.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Universe3D.ico" />
  </ItemGroup>

</Project>
